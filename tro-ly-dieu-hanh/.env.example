# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# File này chỉ khai báo tên biến, không bao giờ chứa giá trị thật.

# --- Google Drive: HAI service account tách biệt, không dùng chung ---
# Tách hai đường là rào chắn chính của hệ thống: nếu prompt injection lừa được
# agent gọi hàm ghi, nó vẫn chỉ ghi được vào đúng thư mục output.

# Chỉ đọc. Scope: drive.metadata.readonly + drive.readonly
# Share quyền Viewer vào các thư mục trong config/folders.yaml → read_roots
GOOGLE_SA_READ_JSON=/duong/dan/toi/sa-read.json

# Chỉ ghi. Scope: drive.file
# Share quyền Editor vào DUY NHẤT thư mục write_root. Không cấp scope xoá.
GOOGLE_SA_WRITE_JSON=/duong/dan/toi/sa-write.json

# --- Claude API ---
# Dùng key riêng cho agent này và đặt hạn mức chi tiêu tháng ở phía Anthropic
# Console. Trần trong code là lớp thứ hai, không phải lớp duy nhất.
ANTHROPIC_API_KEY=

# --- Telegram: kênh xin phê duyệt và gửi cảnh báo ---
TELEGRAM_BOT_TOKEN=
# Chat ID của những người được quyền bấm duyệt, cách nhau bởi dấu phẩy
APPROVER_CHAT_IDS=

# --- Tắt khẩn cấp ---
# Đặt =1 để chặn mọi thao tác ghi và gửi ra ngoài, phần tra cứu vẫn chạy.
AGENT_DISABLED=0
